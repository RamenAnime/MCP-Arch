    { "standard": "大きい", "kyoto": "でっけえ", "example_en": "Big.", "example_ja": "大きい。", "example_kyoto": "でっけえ。" },
    { "standard": "小さい", "kyoto": "ちっちゃい", "example_en": "Small.", "example_ja": "小さい。", "example_kyoto": "ちっちゃい。" }
