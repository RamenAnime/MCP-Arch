###################
# STARTUP         #
###################

# Load Xresources (colors)
exec --no-startup-id xrdb -merge ~/.Xresources

# Compositor for transparency and effects
exec --no-startup-id picom

# Network manager tray icon
exec --no-startup-id nm-applet

# Notification daemon
exec --no-startup-id dunst

# Workspace 1: terminal with Kyoto Learn welcome
exec --no-startup-id i3-msg 'workspace 1; exec alacritty -e bash -c "kyoto-motd 2>/dev/null; echo; echo Run: kyoto-learn  /  i3: Mod+Shift+J; exec bash"'

# Workspace 2: lesson app (optional quick start)
exec --no-startup-id i3-msg 'workspace 2; exec kyoto-learn'

# Return to workspace 1
exec --no-startup-id i3-msg 'workspace 1'
